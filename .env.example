# =============================================================================
# RunIndex — Variables d'environnement
# =============================================================================
# Copier ce fichier vers backend/.env (et .env pour Docker Compose) puis
# remplir chaque valeur.
# JAMAIS committer de secrets réels dans Git — injecter via Doppler/Vault/
# Docker Secrets en production.
# =============================================================================


# -----------------------------------------------------------------------------
# BASE DE DONNÉES — MongoDB
# -----------------------------------------------------------------------------
# URI de connexion MongoDB (Atlas ou instance self-hosted)
# En Docker Compose local : mongodb://runindex:<MONGO_INITDB_ROOT_PASSWORD>@mongo:27017
MONGO_URL=mongodb://mongo:27017

# Nom de la base de données RunIndex
DB_NAME=runindex

# Credentials MongoDB pour le container Docker Compose (développement uniquement)
# En production : utiliser MongoDB Atlas ou un service managé avec auth forte
MONGO_INITDB_ROOT_USERNAME=runindex
MONGO_INITDB_ROOT_PASSWORD=


# -----------------------------------------------------------------------------
# AUTHENTIFICATION — JWT
# -----------------------------------------------------------------------------
# Clé secrète JWT : générer avec `openssl rand -hex 32`
JWT_SECRET_KEY=

# Algorithme JWT (ne pas modifier sauf migration explicite)
JWT_ALGORITHM=HS256

# Durée de vie du token d'accès (en minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# URI Redis (queue de jobs, rate limiter, cache feed, SSE)
REDIS_URL=redis://redis:6379/0


# -----------------------------------------------------------------------------
# ENVIRONNEMENT
# -----------------------------------------------------------------------------
# "development" : CORS élargi, mode démo autorisé, logs verbeux
# "production"  : CORS strict (FRONTEND_URL uniquement), mode démo bloqué
ENVIRONMENT=development

# URL publique du frontend — utilisée pour CORS et les redirections OAuth
FRONTEND_URL=http://localhost:3000

# Origines CORS supplémentaires en développement (séparées par des virgules)
# Ignoré en production (seul FRONTEND_URL est autorisé)
CORS_ORIGINS=

# Nombre de reverse proxies/load balancers devant l'API (pour X-Forwarded-For)
# 0 = pas de proxy, 1 = un seul load balancer, etc.
TRUSTED_PROXY_COUNT=0


# -----------------------------------------------------------------------------
# OAUTH — Google & Apple (client IDs publics uniquement)
# -----------------------------------------------------------------------------
# ID client Google OAuth 2.0 (sûr à exposer côté backend et frontend)
GOOGLE_CLIENT_ID=

# Bundle ID Apple (sûr à exposer côté backend et frontend)
APPLE_CLIENT_ID=

# Adresses email des administrateurs (séparées par des virgules)
ADMIN_EMAILS=


# -----------------------------------------------------------------------------
# PADDLE — Paiements
# -----------------------------------------------------------------------------
# Clé API Paddle (server-side uniquement — ne jamais exposer au frontend)
PADDLE_API_KEY=

# Secret de signature des webhooks Paddle (depuis le dashboard Paddle)
PADDLE_WEBHOOK_SECRET=

# Environnement Paddle : "sandbox" (test) ou "production"
PADDLE_ENVIRONMENT=sandbox

# ID du tarif Premium (depuis le dashboard Paddle)
PADDLE_PRICE_ID=

# Token client Paddle (safe for frontend — Paddle.js)
PADDLE_CLIENT_TOKEN=


# -----------------------------------------------------------------------------
# GARMIN — Credentials du compte de synchronisation
# ATTENTION : compte mono-utilisateur — phase actuelle, voir DEPLOYMENT.md
# -----------------------------------------------------------------------------
# Email du compte Garmin Connect utilisé par gccli
GARMIN_USERNAME=

# Mot de passe du compte Garmin Connect
# Stocké dans le vault chiffré après le premier bootstrap gccli
GARMIN_PASSWORD=


# -----------------------------------------------------------------------------
# LLM / COACH IA
# -----------------------------------------------------------------------------
# Clé API Emergent LLM (accès OpenAI GPT-4o-mini via Emergent)
EMERGENT_LLM_KEY=


# -----------------------------------------------------------------------------
# WORKERS — Sync Garmin (valeurs par défaut suffisantes pour staging)
# -----------------------------------------------------------------------------
# Nombre maximum de syncs Garmin concurrents (global, toutes instances)
SYNC_MAX_CONCURRENCY=5

# Timeout d'un job de sync Garmin (secondes)
SYNC_JOB_TIMEOUT=60

# Nombre maximum de tentatives avant abandon d'un job
SYNC_MAX_RETRIES=3

# Intervalle du watchdog (secondes) — récupère les jobs orphelins
SYNC_WATCHDOG_INTERVAL=30

# Intervalle de sync automatique périodique (secondes, 0 = désactivé)
SYNC_SCHEDULE_INTERVAL=0

# Décalage entre chaque enqueue lors du sync périodique (ms) — anti-thundering-herd
SYNC_SCHEDULE_STAGGER_MS=200


# -----------------------------------------------------------------------------
# FRONTEND — Variables React (prefixe REACT_APP_)
# Ces variables sont intégrées au build frontend, pas au backend.
# -----------------------------------------------------------------------------
# URL du backend API (utilisée par le frontend React)
REACT_APP_BACKEND_URL=http://localhost:8000

# ID client Google OAuth (même valeur que GOOGLE_CLIENT_ID)
REACT_APP_GOOGLE_CLIENT_ID=

# Bundle ID Apple (même valeur que APPLE_CLIENT_ID)
REACT_APP_APPLE_CLIENT_ID=

# URI de redirection Apple OAuth (doit correspondre à la configuration Apple)
REACT_APP_APPLE_REDIRECT_URI=
