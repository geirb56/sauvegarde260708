# ── Runtime environment ────────────────────────────────────────────────────────
# "development" | "production"  (preprod must use "production")
ENVIRONMENT=

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URL=
DB_NAME=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Required by the Garmin sync job queue, SSE feed, and auth rate-limiter.
REDIS_URL=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=

# ── OAuth (Google / Apple) ────────────────────────────────────────────────────
# Server-side audience validation — must match the frontend REACT_APP_* values.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses.
ADMIN_EMAILS=

# ── CORS / URLs ───────────────────────────────────────────────────────────────
# In production CORS is restricted to FRONTEND_URL only.
# CORS_ORIGINS is only used in development (comma-separated extra origins).
FRONTEND_URL=
CORS_ORIGINS=

# ── Paddle (payment — sandbox for preprod) ────────────────────────────────────
# PADDLE_ENVIRONMENT: "sandbox" (preprod) | "production"
PADDLE_ENVIRONMENT=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
PADDLE_CLIENT_TOKEN=

# ── Garmin connector ──────────────────────────────────────────────────────────
# GARMIN_PROVIDER: "gccli" to use the gccli binary; leave blank to disable.
# GARMIN_USERNAME / GARMIN_PASSWORD: used only by the global bootstrap provider.
GARMIN_PROVIDER=
GARMIN_USERNAME=
GARMIN_PASSWORD=

# ── LLM coach (Emergent AI) ───────────────────────────────────────────────────
EMERGENT_LLM_KEY=

# ── Demo mode (NEVER enable in production) ───────────────────────────────────
# DEMO_MODE=true bypasses all subscription checks for every user.
# validate_demo_mode_safety() will raise if DEMO_MODE=true + ENVIRONMENT=production.
DEMO_MODE=

# ── Frontend ──────────────────────────────────────────────────────────────────
REACT_APP_BACKEND_URL=
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_APPLE_CLIENT_ID=
REACT_APP_APPLE_REDIRECT_URI=
